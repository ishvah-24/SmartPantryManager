<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="12dp"
    android:background="#F7F4EB"
    android:fitsSystemWindows="true">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="YOUR KITCHEN"
        android:textSize="12sp"
        android:letterSpacing="0.14"
        android:textStyle="bold"
        android:textColor="#69766B"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/pantryHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="34sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:textColor="#203D30"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Everything you have, all in one place."
        android:textSize="14sp"
        android:textColor="#69766B"
        android:layout_marginBottom="22dp" />

    <Button
        android:id="@+id/addIngredientButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="+  Add an ingredient"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#203D30"
        android:backgroundTint="#E9A23B"
        android:stateListAnimator="@null"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/suggestedRecipesButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Discover recipes  →"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="#203D30"
        android:backgroundTint="#DCE8D5"
        android:stateListAnimator="@null"
        android:layout_marginBottom="22dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pantryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

</LinearLayout>
