<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F4EB"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- Small section label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YOUR KITCHEN"
            android:textSize="12sp"
            android:letterSpacing="0.14"
            android:textStyle="bold"
            android:textColor="#69766B"
            android:layout_marginBottom="8dp" />

        <!-- Screen heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient details"
            android:textSize="34sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textColor="#203D30"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add what you have, so you can make the most of it."
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:textColor="#69766B"
            android:layout_marginBottom="28dp" />

        <!-- Ingredient name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#203D30"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. Tomatoes"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:backgroundTint="#8AA58D"
            android:textColor="#203D30"
            android:textColorHint="#899187"
            android:layout_marginBottom="20dp" />

        <!-- Quantity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#203D30"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/quantityEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. 5"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:backgroundTint="#8AA58D"
            android:textColor="#203D30"
            android:textColorHint="#899187"
            android:layout_marginBottom="20dp" />

        <!-- Unit -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unit of measurement"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#203D30"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/unitEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. kg, g, pieces, ml"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:backgroundTint="#8AA58D"
            android:textColor="#203D30"
            android:textColorHint="#899187"
            android:layout_marginBottom="20dp" />

        <!-- Optional expiry date -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry date (optional)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#203D30"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/expiryDateEditText"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Choose a date"
            android:focusable="false"
            android:clickable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:backgroundTint="#8AA58D"
            android:textColor="#203D30"
            android:textColorHint="#899187"
            android:layout_marginBottom="28dp" />

        <!-- Save button -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save ingredient"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#203D30"
            android:backgroundTint="#E9A23B"
            android:stateListAnimator="@null" />

        <!-- Delete button -->
        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Delete ingredient"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#9B3030"
            android:backgroundTint="#F1DDDA"
            android:stateListAnimator="@null"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
