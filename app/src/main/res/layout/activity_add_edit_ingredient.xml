<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F2"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient Details"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#244A35"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add what you have in your pantry."
            android:textSize="14sp"
            android:textColor="#657568"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingredient name"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:backgroundTint="#8AA58D"
            android:textColor="#244A35"
            android:textColorHint="#7C887D"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/quantityEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity"
            android:inputType="numberDecimal"
            android:padding="14dp"
            android:backgroundTint="#8AA58D"
            android:textColor="#244A35"
            android:textColorHint="#7C887D"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/unitEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unit (e.g. kg, grams, pieces)"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:backgroundTint="#8AA58D"
            android:textColor="#244A35"
            android:textColorHint="#7C887D"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/expiryDateEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expiry date (optional)"
            android:focusable="false"
            android:clickable="true"
            android:padding="14dp"
            android:backgroundTint="#8AA58D"
            android:textColor="#244A35"
            android:textColorHint="#7C887D"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Ingredient"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#356B49" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Ingredient"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#9B3030"
            android:backgroundTint="#F1DDDA"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
